{
  "name": "unused-finder",
  "version": "1.0.0",
  "description": "Fast, zero-config CLI to find unused npm dependencies and orphaned assets.",
  "type": "module",
  "bin": {
    "unused-finder": "bin/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "unused-dependencies",
    "asset-finder",
    "cleanup",
    "cli",
    "dead-code"
  ],
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node --test"
  }
}
